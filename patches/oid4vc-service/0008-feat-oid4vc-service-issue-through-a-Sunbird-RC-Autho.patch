diff --git a/services/oid4vc-service/src/config/configuration.ts b/services/oid4vc-service/src/config/configuration.ts
index e8024be3..67c851b0 100644
--- a/services/oid4vc-service/src/config/configuration.ts
+++ b/services/oid4vc-service/src/config/configuration.ts
@@ -109,7 +109,28 @@ export interface ClaimSourceSpec {
 }
 
 /** Names with built-in meaning, which a declared source must not shadow. */
-const RESERVED_SOURCE_NAMES = new Set(['registry', 'none']);
+const RESERVED_SOURCE_NAMES = new Set(['registry', 'none', 'authority']);
+
+/**
+ * A Sunbird RC Authority Service to issue through.
+ *
+ * Separate from the generic named claim sources because this one does more than
+ * read: it asks the Authority to issue its own credential and carries the
+ * resulting identifier into the SD-JWT, which needs a profile mapping a URL alone
+ * cannot express.
+ */
+export interface AuthorityConfig {
+  /** The Authority Service. Its presence is what declares this source usable. */
+  baseUrl: string;
+  /** Bearer token for the server-to-server call. Never a holder's token. */
+  token?: string;
+  /** Credential schemaId or name -> Authority credential profile id. */
+  profileMap: Record<string, string>;
+  /** The record field a holder's subject identifier is matched against. */
+  subjectField: string;
+  /** Request timeout. A wallet is waiting on this call, so it is bounded. */
+  timeoutMs: number;
+}
 
 /**
