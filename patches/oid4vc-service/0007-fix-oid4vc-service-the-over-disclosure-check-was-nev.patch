 .../oid4vc-service/src/oid4vci/vct.util.ts    |  16 +++
 .../src/oid4vp/oid4vp.service.ts              |   8 ++
 .../src/oid4vp/unrequested-disclosure.spec.ts | 103 ++++++++++++++++++
 4 files changed, 137 insertions(+), 2 deletions(-)

