{
  "realm": "education",
  "displayName": "Education / Employment and Higher Study (synthetic demo)",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "failureFactor": 20,
  "permanentLockout": false,
  "maxDeltaTimeSeconds": 3600,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "waitIncrementSeconds": 30,
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "requiredActions": [
    {
      "alias": "VERIFY_PROFILE",
      "name": "Verify Profile",
      "providerId": "VERIFY_PROFILE",
      "enabled": false,
      "defaultAction": false,
      "priority": 90,
      "config": {}
    },
    {
      "alias": "UPDATE_PASSWORD",
      "name": "Update Password",
      "providerId": "UPDATE_PASSWORD",
      "enabled": false,
      "defaultAction": false,
      "priority": 30,
      "config": {}
    }
  ],
  "defaultDefaultClientScopes": [
    "learner-record"
  ],
  "clientScopes": [
    {
      "name": "learner-record",
      "description": "Carries the nationalId claim each Education issuer resolves in its own registry entity, so no institution depends on another's client state.",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": [
        {
          "name": "nationalId",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "protocol": "openid-connect",
          "consentRequired": false,
          "config": {
            "user.attribute": "nationalId",
            "claim.name": "nationalId",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "name": "school-record-credential",
      "description": "OID4VCI scope for the School Record Credential, as advertised in the State School Board's issuer metadata",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "college-record-credential",
      "description": "OID4VCI scope for the College Record Credential, as advertised in the Regional Polytechnic College's issuer metadata",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    },
    {
      "name": "university-record-credential",
      "description": "OID4VCI scope for the University Record Credential, as advertised in the State University's issuer metadata",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "false"
      },
      "protocolMappers": []
    }
  ],
  "clients": [
    {
      "clientId": "id.animo.paradym",
      "name": "Sunbird Wallet",
      "description": "The holder's wallet: the same public client id as the age and agriculture realms because it is the same installed app. A separate realm so an Agriculture login cannot collect an Education credential.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "webOrigins": [
        "+"
      ],
      "redirectUris": [
        "https://paradym.id/invitation/redirect",
        "https://paradymwallet.app/oauth2/redirect",
        "id.animo.paradym:///wallet/redirect",
        "http://localhost/wallet/redirect",
        "http://localhost:3000/wallet/redirect"
      ],
      "defaultClientScopes": [
        "learner-record",
        "profile",
        "openid"
      ],
      "optionalClientScopes": [
        "school-record-credential",
        "college-record-credential",
        "university-record-credential"
      ]
    }
  ],
