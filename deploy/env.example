# Iteration 01 — Age Verification: local stack configuration.
#
# Copy to .env and edit only if you need to. Every value has a working default
# for a laptop run:
#
#   cp env.example .env && docker compose up -d
#
# .env is gitignored. scripts/bootstrap.sh APPENDS the DIDs it mints to it
# (AGE_ISSUER_DID / VERIFIER_DID / UNTRUSTED_ISSUER_DID) and then recreates the
# two services that read them, so the file is both input and generated state.

# --- public identity of the deployment ---------------------------------------
# PUBLIC_URL is stamped into issuer metadata, minted tokens, request objects,
# `iss`/`aud` and the credential `vct`. It must be the URL a WALLET can reach.
#
# No port, on purpose: a port in a did:web has to be percent-encoded
# (did:web:localhost%3A8080:...), which breaks issuer-DID matching downstream.
#
# For the on-device run, set both of these to the HTTPS tunnel host and re-run
# bootstrap.sh on a clean stack. Changing the host invalidates every did:web and
# every credential already issued, so pin it BEFORE issuing demo credentials.
PUBLIC_URL=http://localhost
PUBLIC_HOST=localhost

# --- local infrastructure ----------------------------------------------------
POSTGRES_PASSWORD=postgres
VAULT_TOKEN=local-root-token

# --- Sunbird RC ---------------------------------------------------------------
# Pinned to the released baseline the design mandates. Do not float this to
# `latest`: the evidence pack records digests for exactly these tags.
RELEASE_VERSION=v2.1.0

# Registry auth is off locally (there is no Keycloak in this stack — Iteration
# 01 has no staff portal). age-issuer is the only writer.
REGISTRY_AUTH_ENABLED=false

# One PostgreSQL database for the showcase, with use cases separated by their own
# tables/entities — Anand's answer 10, now PRODUCT and DESIGN §7. Age owns
# AgeCitizen; Agriculture and Education will own theirs; no shared person table.
#
# The registry names its tables after the entity (V_AgeCitizen), so separation
# needs no schema or database of its own. An earlier attempt to use
# ?currentSchema=age is worth remembering only as a dead end: the registry leaves
# table placement to Sqlg, which writes unqualified labels to `public` regardless.
AGE_REGISTRY_JDBC=jdbc:postgresql://db:5432/registry

# --- OID4VP ------------------------------------------------------------------
# Paradym is Credo-based: it fetches the request object as
# application/oauth-authz-req+jwt and answers 406 to an unsigned request. So
# signing stays ON, which in turn requires a resolvable did:web verifier DID
# (oid4vc-service refuses to sign with a did:rcw).
OID4VP_SIGN_REQUEST=true

# Filled in by scripts/bootstrap.sh — leave blank on a fresh checkout.
AGE_ISSUER_DID=
VERIFIER_DID=
UNTRUSTED_ISSUER_DID=
