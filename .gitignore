node_modules/
# Generated by scripts/bootstrap.sh: carries the locally minted DIDs and the
# dev Vault token. Never committed — deploy/env.example is the checked-in
# template.
deploy/.env
# Evidence captured from a run (screenshots, container digests, test output).
# The write-up in docs/evidence/01-age/ IS committed; raw artifacts are not,
# since they can contain deployment detail that is not useful in Git.
docs/evidence/01-age/artifacts/
.DS_Store
*.log

# Expo continuous native generation: services/verifier-mobile/android is
# regenerated by `expo prebuild`, so committing it invites hand edits that the
# next prebuild silently discards. Native config belongs in app.config.js and
# plugins/ instead (that is why with-openid4vp-query.js exists).
services/verifier-mobile/android/
